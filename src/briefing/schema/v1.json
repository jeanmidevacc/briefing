              "$ref": "#/$defs/table"
            },
            {
              "$ref": "#/$defs/ref"
            }
          ]
        },
        "caption": {
          "description": "Optional caption below the table.",
          "anyOf": [
            {
              "type": [
                "string",
                "null"
              ]
            },
            {
              "$ref": "#/$defs/ref"
            }
          ],
          "default": null
