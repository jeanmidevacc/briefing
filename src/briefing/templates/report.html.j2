<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="generator" content="briefing {{ version }}" />
  <title>{{ report_name }}</title>
  <style>
{{ report_css }}
{{ css_vars }}{{ export_css }}
  </style>
  {% if head_scripts %}{{ head_scripts }}{% endif %}
</head>
<body>
  <div class="bf-report">
    {% if header_html %}
    {{ header_html }}
    {% endif %}
    <main class="bf-report__body">
      {{ content_html }}
    </main>
    <footer class="bf-report__footer">{{ footer_text }}</footer>
  </div>
  {{ embed_data }}{{ report_scripts }}
</body>
</html>
